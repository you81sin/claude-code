# =========================================================
# CHRONOS 環境変数テンプレート
# =========================================================
# 使い方: このファイルを「.env」という名前でコピーして、値を埋める。
#   cp .env.example .env
# .env は .gitignore 済み（APIキーは絶対にコミットしない）。
# 最低限、[1] の LLM プロバイダ1つだけ設定すれば pon は喋れる。
# =========================================================

# --- [1] LLM（必須・どちらか1つ）---
CHRONOS_LLM_PROVIDER=gemini          # gemini または anthropic
GEMINI_API_KEY=                      # https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY=                 # provider=anthropic のとき

# --- 文字化け対策（Windows推奨）---
PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# --- [2] 天気（任意・APIキー不要 / wttr.in）---
# 都市名を英語で。例: Tokyo / Osaka / Sapporo
CITY=

# --- [3] 音声合成 Style-Bert-VITS2（任意）---
# SBV2 のインストール先。別途サーバを起動して http://127.0.0.1:5000 で待ち受ける。
SBV2_DIR=

# --- [4] 画像生成（任意）---
SEGMIND_API_KEY=
NOVELAI_TOKEN=

# --- [5] 3Dアバター生成（任意・実験用）---
TRIPO_API_KEY=
NEURAL4D_API_KEY=

# --- [6] YouTube ライブ連携（任意）---
# YOUTUBE_VIDEO_ID=                  # 設定すると起動時にライブチャットへ自動接続
